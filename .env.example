# Postgres connection string.
# - Local dev: use the docker-compose database (the app auto-selects the
#   node-postgres driver for localhost URLs):
DATABASE_URL="postgres://mindbug:mindbug@localhost:5433/mindbug"
# - Production: a Neon connection string (the app uses the Neon HTTP driver):
#   DATABASE_URL="postgres://user:pass@host.neon.tech/db?sslmode=require"

# Better Auth — Google SSO
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=generate-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
